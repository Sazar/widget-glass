      "textResub":     { "type": "text", "label": "Texte Resub",      "value": "RESUBSCRIPTION"  },
      "iconDonation":  { "type": "text", "label": "Icône Donation",   "value": "💎" },
      "textDonation":  { "type": "text", "label": "Texte Donation",   "value": "DONATION"        },
      "iconRaid":      { "type": "text", "label": "Icône Raid",       "value": "⚔️" },
      "textRaid":      { "type": "text", "label": "Texte Raid",       "value": "RAID INCOMING"   },
      "iconCheer":     { "type": "text", "label": "Icône Cheer",      "value": "🎉" },
      "textCheer":     { "type": "text", "label": "Texte Cheer",      "value": "BITS"             },
