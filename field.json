{
  "general": {
    "type": "group",
    "label": "⚙️ Général",
    "value": true,
    "fields": {
      "duration": {
        "type": "number",
        "label": "Durée d'affichage (ms)",
        "value": 7000,
        "min": 3000,
        "max": 15000,
        "step": 500
      },
      "widgetPosition": {
        "type": "dropdown",
        "label": "Position du widget",
        "value": "center",
        "options": [
          { "label": "Centre",       "value": "center"        },
          { "label": "Haut gauche",  "value": "top-left"      },
          { "label": "Haut centre",  "value": "top-center"    },
          { "label": "Haut droite",  "value": "top-right"     },
          { "label": "Bas gauche",   "value": "bottom-left"   },
          { "label": "Bas centre",   "value": "bottom-center" },
          { "label": "Bas droite",   "value": "bottom-right"  }
        ]
      },
      "widgetWidth": {
        "type": "number",
        "label": "Largeur (px)",
        "value": 660,
        "min": 400,
        "max": 900,
        "step": 10
      }
    }
  },

  "apparence": {
    "type": "group",
    "label": "🎨 Apparence",
    "value": true,
    "fields": {
      "themePreset": {
        "type": "dropdown",
        "label": "Preset de thème",
        "value": "custom",
        "options": [
          { "label": "Personnalisé",       "value": "custom"        },
          { "label": "Neon Cyan (défaut)", "value": "neon-cyan"     },
          { "label": "Gold",               "value": "gold"          },
          { "label": "Purple Storm",       "value": "purple-storm"  },
          { "label": "Minimal White",      "value": "minimal-white" },
          { "label": "Green Matrix",       "value": "green-matrix"  }
        ]
      },
      "primaryColor":    { "type": "colorpicker", "label": "Couleur principale",      "value": "#00f5ff" },
      "accentColor":     { "type": "colorpicker", "label": "Couleur d'accent",         "value": "#ff2ec4" },
      "borderRadius":    { "type": "number",  "label": "Arrondi des coins (px)",       "value": 28,   "min": 0,   "max": 50,  "step": 2    },
      "blurIntensity":   { "type": "number",  "label": "Intensité du flou (px)",       "value": 28,   "min": 10,  "max": 50,  "step": 2    },
      "glassOpacity":    { "type": "slider",  "label": "Opacité du glass",             "value": 0.45, "min": 0.1, "max": 0.9, "step": 0.05 },
      "glowIntensity":   { "type": "number",  "label": "Intensité du glow (px)",       "value": 20,   "min": 0,   "max": 60,  "step": 2    },
      "showProgressBar": { "type": "checkbox","label": "Barre de progression",         "value": true  },
      "showParticles":   { "type": "checkbox","label": "Particules",                   "value": true  },
      "particleCount":   { "type": "number",  "label": "Nombre de particules",         "value": 55,   "min": 10,  "max": 100, "step": 5    },
      "showAvatar":      { "type": "checkbox","label": "Avatar Twitch",                "value": false }
    }
  },

  "typographie": {
    "type": "group",
    "label": "🔤 Typographie",
    "value": false,
    "fields": {
      "iconSize":     { "type": "number", "label": "Taille icônes (px)",  "value": 56,   "min": 30, "max": 80, "step": 2   },
      "typeSize":     { "type": "number", "label": "Taille type (px)",    "value": 15.5, "min": 12, "max": 24, "step": 0.5 },
      "usernameSize": { "type": "number", "label": "Taille pseudo (px)",  "value": 49,   "min": 30, "max": 70, "step": 1   },
      "messageSize":  { "type": "number", "label": "Taille message (px)", "value": 23,   "min": 16, "max": 32, "step": 1   },
      "amountSize":   { "type": "number", "label": "Taille montant (px)", "value": 35,   "min": 24, "max": 50, "step": 1   }
    }
  },

  "evenements": {
    "type": "group",
